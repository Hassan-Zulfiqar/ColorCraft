<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ColorCraft" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary_start</item>
        <item name="colorOnPrimary">@color/color_white</item>
        <item name="colorSecondary">@color/color_secondary_start</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_text_primary</item>
        <item name="colorError">@color/color_error</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ColorCraft" parent="Base.Theme.ColorCraft" />

    <style name="Theme.ColorCraft.Splash" parent="Theme.ColorCraft">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>