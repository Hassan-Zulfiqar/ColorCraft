<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.16"
        android:background="@drawable/gradient_primary_card" />

    <LinearLayout
        android:id="@+id/tap_to_fill_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:background="@drawable/bg_pill_solid_white"
        android:backgroundTint="@color/color_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_error" />

        <TextView
            android:id="@+id/tap_to_fill_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:fontFamily="@font/inter"
            android:text="@string/tap_to_fill_label"
            android:textColor="@color/color_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/elephant_image"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_elephant_illustration"
        app:layout_constraintBottom_toTopOf="@id/dot_accent_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55" />

    <LinearLayout
        android:id="@+id/dot_accent_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_primary_start" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_error" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_teal" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_secondary_end" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/shape_circle_solid"
            android:backgroundTint="@color/color_secondary_start" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
