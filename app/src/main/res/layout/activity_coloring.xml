<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/top_bar_end_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/undo_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:contentDescription="@string/cd_undo"
                android:src="@drawable/ic_undo" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/redo_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:contentDescription="@string/cd_redo"
                android:src="@drawable/ic_redo" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/title_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toStartOf="@id/top_bar_end_group"
        app:layout_constraintStart_toEndOf="@id/back_button"
        app:layout_constraintTop_toTopOf="@id/back_button">

        <TextView
            android:id="@+id/drawing_title_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Cosmic Butterfly" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/canvas_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_md"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="3dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/coloring_canvas_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

<!--            <TextView-->
<!--                android:id="@+id/zoom_level_text"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_gravity="bottom|end"-->
<!--                android:layout_margin="@dimen/spacing_sm"-->
<!--                android:background="@drawable/bg_pill_pale"-->
<!--                android:fontFamily="@font/inter"-->
<!--                android:paddingStart="@dimen/spacing_sm"-->
<!--                android:paddingEnd="@dimen/spacing_sm"-->
<!--                android:paddingTop="4dp"-->
<!--                android:paddingBottom="4dp"-->
<!--                android:text="@string/zoom_level_default"-->
<!--                android:textColor="@color/color_text_secondary"-->
<!--                android:textSize="12sp"-->
<!--                android:textStyle="bold" />-->

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/open_color_picker_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/color_swatch_recycler_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/color_swatch_recycler_view">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_primary"
            android:contentDescription="Custom color" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/color_swatch_recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/open_color_picker_button"
        app:layout_constraintTop_toBottomOf="@id/canvas_card"
        tools:itemCount="6"
        tools:listitem="@layout/item_color_swatch" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_fill_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:text="@string/tool_fill_label"
        android:textColor="@color/color_primary_start"
        android:textSize="14sp"
        app:backgroundTint="@color/color_surface_alt"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_fill"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/spacing_xs"
        app:iconSize="18dp"
        app:iconTint="@color/color_primary_start"
        app:strokeWidth="1dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tool_zoom_button"
        app:layout_constraintTop_toBottomOf="@id/color_swatch_recycler_view" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_zoom_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:text="@string/tool_zoom_label"
        android:textColor="@color/color_text_primary"
        android:textSize="14sp"
        app:backgroundTint="@color/color_surface"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_zoom"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/spacing_xs"
        app:iconSize="18dp"
        app:iconTint="@color/color_text_primary"
        app:strokeWidth="1dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/tool_fill_button"
        app:layout_constraintEnd_toStartOf="@id/tool_reset_button"
        app:layout_constraintTop_toTopOf="@id/tool_fill_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tool_reset_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:text="@string/tool_reset_label"
        android:textColor="@color/color_error"
        android:textSize="14sp"
        app:backgroundTint="@color/color_surface"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_reset"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/spacing_xs"
        app:iconSize="18dp"
        app:iconTint="@color/color_error"
        app:strokeWidth="1dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/tool_zoom_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tool_fill_button" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/save_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="100dp"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tool_fill_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/inter"
                android:text="@string/save_artwork_button_text"
                android:textColor="@color/color_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
